#version 450

#include "common_bindings.glsl"
#include "common_frame.glsl"

#define SHUTTLE_MAX_HIZ_MIP_COUNT 16

// Каждая workgroup 8x8 потоков читает 16x16 texel из linearDepthImage.
//
// Локально строит:
// MIP 0: копия linear depth
// MIP 1: 8x8
// MIP 2: 4x4
// MIP 3: 2x2
// MIP 4: 1x1
//
// После этого каждая workgroup представляет один texel MIP 4.
// MIP 5+ строятся через global atomic cascade.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ============================================================
// Push Constants
// ============================================================
//
// totalMipCount:
//   Количество mip-уровней, включая MIP 0.
//   Например: MIP 0..10 => totalMipCount = 11.
//
// counterCount:
//   Количество uint-счётчиков в FRAME_HIZ_COUNTERS.
//   Должно равняться сумме размеров MIP 5..totalMipCount-1.
//
layout(push_constant) uniform PushConstants
{
    uint totalMipCount;
    uint counterCount;
}
pc;

// ============================================================
// Renderer Set
// ============================================================

layout(set = SET_RENDERER, binding = RENDERER_NEAREST_SAMPLER)
uniform sampler nearestSampler;

// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME, binding = FRAME_INFO, std140)
uniform FrameInfoBuffer
{
    FrameInfo frame;
};

layout(set = SET_FRAME, binding = FRAME_LINEAR_DEPTH_IMAGE)
uniform texture2D linearDepthImage;

// hizStorageImages[0] = MIP 0
// hizStorageImages[1] = MIP 1
// hizStorageImages[2] = MIP 2
// hizStorageImages[3] = MIP 3
// hizStorageImages[4] = MIP 4
// hizStorageImages[5] = MIP 5
// ...
//
// Не writeonly, потому что MIP 5+ читают предыдущие уровни через imageLoad.
layout(set = SET_FRAME, binding = FRAME_HIZ_STORAGE_IMAGES, r32f)
coherent uniform image2D hizStorageImages[SHUTTLE_MAX_HIZ_MIP_COUNT];

// Счётчики для single-dispatch atomic cascade.
// Используются только для MIP 5+.
layout(set = SET_FRAME, binding = FRAME_HIZ_COUNTERS, std430)
coherent buffer HiZCounterBuffer
{
    uint mipCounters[];
};

// ============================================================
// Shared memory
// ============================================================

shared float sMip1[8][8];
shared float sMip2[4][4];
shared float sMip3[2][2];

shared uint workGroupTicket;

// ============================================================
// Depth reduction
// ============================================================
//
// Для обычного depth / linear depth:
//   ближе = меньше
//   дальше = больше
//
// Hi-Z хранит max depth.

const float HIZ_NEUTRAL_DEPTH = 0.0;

float reduceDepth(float a, float b)
{
    return max(a, b);
}

float reduce4(float a, float b, float c, float d)
{
    return reduceDepth(
            reduceDepth(a, b),
            reduceDepth(c, d));
}

// ============================================================
// Mip helpers
// ============================================================
//
// ВАЖНО:
// Vulkan mip dimensions считаются через floor division:
//
//   mipN = max(mipN-1 / 2, 1)
//
// Для 1800x1000:
//   0: 1800 x 1000
//   1: 900  x 500
//   2: 450  x 250
//   3: 225  x 125
//   4: 112  x 62
//   5: 56   x 31
//   6: 28   x 15
//   7: 14   x 7
//   8: 7    x 3
//   9: 3    x 1
//   10: 1   x 1
//
// НЕ использовать ceilDiv2 здесь.
//

ivec2 floorDiv2Min1(ivec2 v)
{
    return max(v / 2, ivec2(1));
}

ivec2 getMip0Size()
{
    return ivec2(frame.renderResolution);
}

ivec2 getMipSize(uint mip)
{
    ivec2 s = getMip0Size();

    for (uint i = 0u; i < mip; ++i)
    {
        s = floorDiv2Min1(s);
    }

    return s;
}

// ============================================================
// Safe reads
// ============================================================

float safeFetchLinearDepth(ivec2 coord)
{
    ivec2 mip0Size = getMip0Size();

    if (coord.x < 0 ||
        coord.y < 0 ||
        coord.x >= mip0Size.x ||
        coord.y >= mip0Size.y)
    {
        return HIZ_NEUTRAL_DEPTH;
    }

    return texelFetch(
            sampler2D(linearDepthImage, nearestSampler),
            coord,
            0).r;
}

float safeLoadHiZMip(uint mip, ivec2 coord, ivec2 mipSize)
{
    if (mip >= SHUTTLE_MAX_HIZ_MIP_COUNT)
    {
        return HIZ_NEUTRAL_DEPTH;
    }

    if (coord.x < 0 ||
        coord.y < 0 ||
        coord.x >= mipSize.x ||
        coord.y >= mipSize.y)
    {
        return HIZ_NEUTRAL_DEPTH;
    }

    return imageLoad(
            hizStorageImages[mip],
            coord).r;
}

// ============================================================
// Counter indexing for MIP 5+
// ============================================================
//
// Для каждого mip >= 5 нужен массив счётчиков размером mipSize(mip).
// Один счётчик на один output texel этого mip.

uint getCounterOffsetForMip(uint mip)
{
    uint offset = 0u;

    for (uint m = 5u; m < mip; ++m)
    {
        ivec2 s = getMipSize(m);
        offset += uint(s.x * s.y);
    }

    return offset;
}

uint getCounterIndexForMip(uint mip, ivec2 outCoord)
{
    ivec2 mipSize = getMipSize(mip);

    uint localIndex =
    uint(outCoord.y * mipSize.x + outCoord.x);

    return getCounterOffsetForMip(mip) + localIndex;
}

uint getExpectedSourceCount(ivec2 outCoord, ivec2 previousMipSize)
{
    ivec2 base = outCoord * 2;

    uint countX = 0u;
    uint countY = 0u;

    if (base.x < previousMipSize.x)
    {
        countX = 1u;

        if (base.x + 1 < previousMipSize.x)
        {
            countX = 2u;
        }
    }

    if (base.y < previousMipSize.y)
    {
        countY = 1u;

        if (base.y + 1 < previousMipSize.y)
        {
            countY = 2u;
        }
    }

    return countX * countY;
}

// ============================================================
// Store helpers
// ============================================================

void storeMip0IfValid(ivec2 coord, float value)
{
    ivec2 mip0Size = getMipSize(0u);

    if (coord.x < mip0Size.x &&
        coord.y < mip0Size.y)
    {
        imageStore(
                hizStorageImages[0],
                coord,
                vec4(value, 0.0, 0.0, 0.0));
    }
}

// ============================================================
// Main
// ============================================================

void main()
{
    ivec2 threadId =
    ivec2(gl_LocalInvocationID.xy);

    ivec2 groupId =
    ivec2(gl_WorkGroupID.xy);

    uint totalMipCount =
    min(pc.totalMipCount, uint(SHUTTLE_MAX_HIZ_MIP_COUNT));

    ivec2 mip1Size = getMipSize(1u);
    ivec2 mip2Size = getMipSize(2u);
    ivec2 mip3Size = getMipSize(3u);
    ivec2 mip4Size = getMipSize(4u);

    // ============================================================
    // Stage 0 + 1:
    // Read 2x2 from linear depth.
    // Store MIP 0.
    // Build MIP 1.
    // ============================================================

    ivec2 mip1Coord =
    groupId * 8 + threadId;

    ivec2 srcCoord =
    mip1Coord * 2;

    float z00 =
    safeFetchLinearDepth(srcCoord + ivec2(0, 0));

    float z10 =
    safeFetchLinearDepth(srcCoord + ivec2(1, 0));

    float z01 =
    safeFetchLinearDepth(srcCoord + ivec2(0, 1));

    float z11 =
    safeFetchLinearDepth(srcCoord + ivec2(1, 1));

    if (totalMipCount > 0u)
    {
        storeMip0IfValid(srcCoord + ivec2(0, 0), z00);
        storeMip0IfValid(srcCoord + ivec2(1, 0), z10);
        storeMip0IfValid(srcCoord + ivec2(0, 1), z01);
        storeMip0IfValid(srcCoord + ivec2(1, 1), z11);
    }

    float mip1Value =
    reduce4(z00, z10, z01, z11);

    sMip1[threadId.y][threadId.x] =
    mip1Value;

    if (totalMipCount > 1u)
    {
        if (mip1Coord.x < mip1Size.x &&
            mip1Coord.y < mip1Size.y)
        {
            imageStore(
                    hizStorageImages[1],
                    mip1Coord,
                    vec4(mip1Value, 0.0, 0.0, 0.0));
        }
    }

    barrier();

    // ============================================================
    // Stage 2:
    // Build MIP 2 from shared MIP 1.
    // ============================================================

    if (threadId.x < 4 &&
        threadId.y < 4)
    {
        ivec2 localBase =
        threadId * 2;

        float a = sMip1[localBase.y + 0][localBase.x + 0];
        float b = sMip1[localBase.y + 0][localBase.x + 1];
        float c = sMip1[localBase.y + 1][localBase.x + 0];
        float d = sMip1[localBase.y + 1][localBase.x + 1];

        float mip2Value =
        reduce4(a, b, c, d);

        sMip2[threadId.y][threadId.x] =
        mip2Value;

        ivec2 mip2Coord =
        groupId * 4 + threadId;

        if (totalMipCount > 2u)
        {
            if (mip2Coord.x < mip2Size.x &&
                mip2Coord.y < mip2Size.y)
            {
                imageStore(
                        hizStorageImages[2],
                        mip2Coord,
                        vec4(mip2Value, 0.0, 0.0, 0.0));
            }
        }
    }

    barrier();

    // ============================================================
    // Stage 3:
    // Build MIP 3 from shared MIP 2.
    // ============================================================

    if (threadId.x < 2 &&
        threadId.y < 2)
    {
        ivec2 localBase =
        threadId * 2;

        float a = sMip2[localBase.y + 0][localBase.x + 0];
        float b = sMip2[localBase.y + 0][localBase.x + 1];
        float c = sMip2[localBase.y + 1][localBase.x + 0];
        float d = sMip2[localBase.y + 1][localBase.x + 1];

        float mip3Value =
        reduce4(a, b, c, d);

        sMip3[threadId.y][threadId.x] =
        mip3Value;

        ivec2 mip3Coord =
        groupId * 2 + threadId;

        if (totalMipCount > 3u)
        {
            if (mip3Coord.x < mip3Size.x &&
                mip3Coord.y < mip3Size.y)
            {
                imageStore(
                        hizStorageImages[3],
                        mip3Coord,
                        vec4(mip3Value, 0.0, 0.0, 0.0));
            }
        }
    }

    barrier();

    // ============================================================
    // Stage 4:
    // Build MIP 4 locally.
    // ============================================================

    if (threadId.x == 0 &&
        threadId.y == 0)
    {
        float mip4Value =
        reduce4(
                sMip3[0][0],
                sMip3[0][1],
                sMip3[1][0],
                sMip3[1][1]);

        ivec2 mip4Coord =
        groupId;

        if (totalMipCount > 4u)
        {
            if (mip4Coord.x < mip4Size.x &&
                mip4Coord.y < mip4Size.y)
            {
                imageStore(
                        hizStorageImages[4],
                        mip4Coord,
                        vec4(mip4Value, 0.0, 0.0, 0.0));
            }
        }
    }

    barrier();

    // Если есть только MIP 0..4, дальше строить нечего.
    if (totalMipCount <= 5u)
    {
        return;
    }

    // ============================================================
    // Stage 5:
    // Build MIP 5+ through atomic cascade.
    // ============================================================

    uint currentMip =
    5u;

    ivec2 previousMipSize =
    mip4Size;

    ivec2 currentMipSize =
    getMipSize(currentMip);

    ivec2 currentGroupCoord =
    groupId;

    while (currentMip < totalMipCount)
    {
        if (currentGroupCoord.x >= previousMipSize.x ||
            currentGroupCoord.y >= previousMipSize.y)
        {
            return;
        }

        ivec2 outCoord =
        currentGroupCoord / 2;

        if (outCoord.x >= currentMipSize.x ||
            outCoord.y >= currentMipSize.y)
        {
            return;
        }

        uint expectedCount =
        getExpectedSourceCount(
                outCoord,
                previousMipSize);

        if (expectedCount == 0u)
        {
            return;
        }

        // ------------------------------------------------------------
        // Signal readiness of previous mip texel.
        // ------------------------------------------------------------

        if (threadId.x == 0 &&
            threadId.y == 0)
        {
            memoryBarrierImage();
            memoryBarrierBuffer();

            uint counterIndex =
            getCounterIndexForMip(
                    currentMip,
                    outCoord);

            if (counterIndex >= pc.counterCount)
            {
                workGroupTicket = 0xFFFFFFFFu;
            }
            else
            {
                workGroupTicket =
                atomicAdd(
                        mipCounters[counterIndex],
                        1u);
            }
        }

        barrier();

        if (workGroupTicket == 0xFFFFFFFFu)
        {
            return;
        }

        // Not the last group for this 2x2 block.
        if (workGroupTicket != expectedCount - 1u)
        {
            return;
        }

        // ------------------------------------------------------------
        // Last group builds current mip texel.
        // ------------------------------------------------------------

        if (threadId.x == 0 &&
            threadId.y == 0)
        {
            memoryBarrierImage();
            memoryBarrierBuffer();

            ivec2 srcBase =
            outCoord * 2;

            float a =
            safeLoadHiZMip(
                    currentMip - 1u,
                    srcBase + ivec2(0, 0),
                    previousMipSize);

            float b =
            safeLoadHiZMip(
                    currentMip - 1u,
                    srcBase + ivec2(1, 0),
                    previousMipSize);

            float c =
            safeLoadHiZMip(
                    currentMip - 1u,
                    srcBase + ivec2(0, 1),
                    previousMipSize);

            float d =
            safeLoadHiZMip(
                    currentMip - 1u,
                    srcBase + ivec2(1, 1),
                    previousMipSize);

            float currentMipValue =
            reduce4(a, b, c, d);

            imageStore(
                    hizStorageImages[currentMip],
                    outCoord,
                    vec4(currentMipValue, 0.0, 0.0, 0.0));
        }

        barrier();

        // This workgroup now represents outCoord of currentMip.
        currentGroupCoord =
        outCoord;

        previousMipSize =
        currentMipSize;

        ++currentMip;

        if (currentMip >= totalMipCount)
        {
            break;
        }

        currentMipSize =
        getMipSize(currentMip);
    }
}