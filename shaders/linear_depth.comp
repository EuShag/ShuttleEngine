#version 450

#include "common_bindings.glsl"
#include "common_frame.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ============================================================
// Renderer Set
// ============================================================

layout(set = SET_RENDERER, binding = RENDERER_NEAREST_SAMPLER) uniform sampler nearestSampler;

// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME, binding = FRAME_INFO, std140) uniform FrameInfoBuffer
{
    FrameInfo frame;
};

layout(set = SET_FRAME, binding = FRAME_DEPTH_IMAGE) uniform texture2D depthImage;

layout(set = SET_FRAME, binding = FRAME_LINEAR_DEPTH_STORAGE_IMAGE, r32f) writeonly uniform image2D linearDepthImage;

// ============================================================
// Helpers
// ============================================================

float linearizeDepth(float depth)
{
    float nearPlane = frame.nearPlane;
    float farPlane = frame.farPlane;

    return (nearPlane * farPlane) / (farPlane - depth * (farPlane - nearPlane));
}

// ============================================================
// Main
// ============================================================

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(frame.renderResolution);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) * frame.invRenderResolution;

    float rawDepth = texture(sampler2D(depthImage, nearestSampler), uv).r;
    float linearDepth = linearizeDepth(rawDepth);

    imageStore(linearDepthImage, pixel, vec4(linearDepth, 0.0, 0.0, 0.0));
}