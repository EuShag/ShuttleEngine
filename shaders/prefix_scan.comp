#version 450

#include "common_bindings.glsl"
#include "common_scene.glsl"
#include "common_frame.glsl"

// Safe sequential scan in one invocation:
// vkCmdDispatch(1, 1, 1)
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;


// ============================================================
// Push Constants
// ============================================================

layout(push_constant) uniform PushConstants
{
    uint commandCount;
} pc;


// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME,
binding = FRAME_INDIRECT_COMMANDS,
std430)
buffer IndirectCommandBuffer
{
    VkDrawIndexedIndirectCommand commands[];
};

layout(set = SET_FRAME,
binding = FRAME_DRAW_COUNT,
std430)
buffer DrawCountBuffer
{
    uint drawCount;
};

layout(set = SET_FRAME,
binding = FRAME_MESH_RANGES,
std430)
buffer MeshRangesBuffer
{
    uint meshRanges[];
};


// ============================================================
// Main
// ============================================================

void main()
{
    uint runningInstanceOffset = 0u;

    for (uint commandId = 0u;
        commandId < pc.commandCount;
    ++commandId)
    {
        uint instanceCount =
        commands[commandId].instanceCount;

        commands[commandId].firstInstance =
        runningInstanceOffset;

        meshRanges[commandId] =
        runningInstanceOffset;

        runningInstanceOffset +=
        instanceCount;
    }

    // IMPORTANT:
    //
    // commands[] is sparse:
    //
    // commandIndex = meshIndex * MAX_MESH_LODS + lodIndex
    //
    // Therefore drawCount cannot be the number of active commands,
    // unless commands are compacted into the beginning of the buffer.
    //
    // Empty commands have instanceCount = 0,
    // so drawing the full command table is safe.
    drawCount =
    pc.commandCount;
}