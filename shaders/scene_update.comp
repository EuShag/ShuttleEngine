#version 450

#include "common_bindings.glsl"
#include "common_scene.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ============================================================
// Push Constants
// ============================================================

layout(push_constant) uniform PushConstants
{
    uint startNodeIndex;
    uint nodeCount;
}

pc;

// ============================================================
// Scene Nodes
// ============================================================

layout(set = SET_SCENE, binding = SCENE_NODES, std430) readonly buffer SceneNodeBuffer
{
    SceneNode nodes[];
};

// ============================================================
// Local Transforms
// ============================================================

layout(set = SET_SCENE, binding = SCENE_TRANSFORMS, std430) readonly buffer TransformBuffer
{
    LocalTransform transforms[];
};

// ============================================================
// World Transforms
// ============================================================

layout(set = SET_FRAME, binding = FRAME_WORLD_TRANSFORMS, std430) buffer WorldTransformBuffer
{
    mat4 worldTransforms[];
};

// ============================================================
// Helpers
// ============================================================

mat4 makeTranslationMatrix(vec3 t)
{
    mat4 result = mat4(1.0);
    result[3] = vec4(t, 1.0);

    return result;
}

mat4 makeScaleMatrix(vec3 s)
{
    mat4 result = mat4(1.0);

    result[0][0] = s.x;
    result[1][1] = s.y;
    result[2][2] = s.z;

    return result;
}

mat4 quaternionToMatrix(vec4 q)
{
    float x = q.x;
    float y = q.y;
    float z = q.z;
    float w = q.w;

    float xx = x * x;
    float yy = y * y;
    float zz = z * z;

    float xy = x * y;
    float xz = x * z;
    float yz = y * z;

    float wx = w * x;
    float wy = w * y;
    float wz = w * z;

    mat4 result = mat4(1.0);

    result[0][0] = 1.0 - 2.0 * (yy + zz);
    result[0][1] = 2.0 * (xy + wz);
    result[0][2] = 2.0 * (xz - wy);

    result[1][0] = 2.0 * (xy - wz);
    result[1][1] = 1.0 - 2.0 * (xx + zz);
    result[1][2] = 2.0 * (yz + wx);

    result[2][0] = 2.0 * (xz + wy);
    result[2][1] = 2.0 * (yz - wx);
    result[2][2] = 1.0 - 2.0 * (xx + yy);

    return result;
}

mat4 computeLocalMatrix(LocalTransform transform)
{
    return makeTranslationMatrix(transform.translation) * quaternionToMatrix(transform.rotationQuat) *
           makeScaleMatrix(transform.scale);
}

// ============================================================
// Main
// ============================================================

void main()
{
    uint localIndex = gl_GlobalInvocationID.x;

    if (localIndex >= pc.nodeCount) return;

    uint nodeIndex = pc.startNodeIndex + localIndex;

    SceneNode node = nodes[nodeIndex];
    LocalTransform localTransform = transforms[node.transformIndex];

    mat4 localMatrix = computeLocalMatrix(localTransform);

    if (node.parentIndex == INVALID_INDEX_U32)
    {
        worldTransforms[nodeIndex] = localMatrix;
        return;
    }

    worldTransforms[nodeIndex] = worldTransforms[node.parentIndex] * localMatrix;
}