#version 450

#include "common_bindings.glsl"
#include "common_scene.glsl"
#include "common_frame.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================
// Renderer Set
// ============================================================

layout(set = SET_RENDERER, binding = RENDERER_NEAREST_SAMPLER) uniform sampler nearestSampler;

// ============================================================
// Scene Set
// ============================================================

layout(set = SET_SCENE, binding = SCENE_DRAWABLES, std430) readonly buffer DrawableBuffer
{
    GpuDrawableObject drawables[];
};

layout(set = SET_SCENE, binding = SCENE_MESHES, std430) readonly buffer MeshBuffer
{
    GpuMesh meshes[];
};

// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME, binding = FRAME_INFO, std140) uniform FrameInfoBuffer
{
    FrameInfo frame;
};

layout(set = SET_FRAME, binding = FRAME_WORLD_TRANSFORMS, std430) readonly buffer WorldTransformBuffer
{
    mat4 worldTransforms[];
};

layout(set = SET_FRAME, binding = FRAME_VISIBLE_CANDIDATE_INDICES, std430) readonly buffer VisibleCandidateIndicesBuffer
{
    uint visibleCandidateIndices[];
};

layout(set = SET_FRAME, binding = FRAME_VISIBLE_CANDIDATE_COUNT, std430) readonly buffer VisibleCandidateCountBuffer
{
    uint visibleCandidateCount;
};

layout(set = SET_FRAME, binding = FRAME_VISIBILITY_FLAGS, std430) buffer VisibilityFlagsBuffer
{
    uint visibilityFlags[];
};

layout(set = SET_FRAME, binding = FRAME_CHOSEN_MESH_IDS, std430) buffer ChosenMeshIdsBuffer
{
    uint chosenMeshIds[];
};

layout(set = SET_FRAME, binding = FRAME_INDIRECT_COMMANDS, std430) buffer IndirectCommandBuffer
{
    VkDrawIndexedIndirectCommand commands[];
};

layout(set = SET_FRAME, binding = FRAME_VISIBILITY_MASKS, std430) buffer VisibilityMaskBuffer
{
    uint visibilityMasks[];
};

layout(set = SET_FRAME, binding = FRAME_HIZ_PYRAMID_IMAGE) uniform texture2D hiZPyramid;

layout(set = SET_FRAME, binding = FRAME_RENDER_STATISTICS, std430) buffer RenderStatisticsBuffer
{
    RenderStatistics stats;
};

// ============================================================
// Helpers
// ============================================================

bool hasMeshFlag(uint flags, uint flag)
{
    return (flags & flag) != 0u;
}

float getMaxScale(mat4 m)
{
    float sx = length(m[0].xyz);
    float sy = length(m[1].xyz);
    float sz = length(m[2].xyz);

    return max(max(sx, sy), sz);
}

bool projectSphereToScreen(vec3 worldCenter, float worldRadius, out vec2 uvMin, out vec2 uvMax, out float nearestDepth,
                           out float screenExtent)
{
    vec4 viewCenter4 = frame.viewMatrix * vec4(worldCenter, 1.0);

    vec3 viewCenter = viewCenter4.xyz;

    float viewDepth = -viewCenter.z;

    if (viewDepth <= frame.nearPlane)
    {
        return false;
    }

    nearestDepth = max(viewDepth - worldRadius, frame.nearPlane);

    vec4 clip = frame.projectionMatrix * vec4(viewCenter, 1.0);

    if (clip.w <= 0.0)
    {
        return false;
    }

    vec2 ndcCenter = clip.xy / clip.w;

    vec2 uvCenter = ndcCenter * 0.5 + 0.5;

    float safeDepth = max(viewDepth, 0.001);

    vec2 projectedRadiusUv =
        vec2(frame.projectionMatrix[0][0], frame.projectionMatrix[1][1]) * worldRadius / safeDepth * 0.5;

    uvMin = uvCenter - projectedRadiusUv;

    uvMax = uvCenter + projectedRadiusUv;

    vec2 pixelSize = max((uvMax - uvMin) * frame.renderResolution, vec2(1.0));

    screenExtent = max(pixelSize.x, pixelSize.y);

    return true;
}

bool isScreenRectOutside(vec2 uvMin, vec2 uvMax)
{
    return uvMax.x < 0.0 || uvMax.y < 0.0 || uvMin.x > 1.0 || uvMin.y > 1.0;
}

float chooseHiZMip(vec2 uvMin, vec2 uvMax)
{
    vec2 clampedMin = clamp(uvMin, vec2(0.0), vec2(1.0));

    vec2 clampedMax = clamp(uvMax, vec2(0.0), vec2(1.0));

    vec2 pixelSize = max((clampedMax - clampedMin) * frame.renderResolution, vec2(1.0));

    float maxExtent = max(pixelSize.x, pixelSize.y);

    float mip = ceil(log2(maxExtent)) - 1.0;

    mip = max(mip, 0.0);

    float maxMip = float(textureQueryLevels(sampler2D(hiZPyramid, nearestSampler)) - 1);

    return clamp(mip, 0.0, maxMip);
}

float sampleHiZMaxDepth(vec2 uvMin, vec2 uvMax, float mip)
{
    vec2 a = clamp(uvMin, vec2(0.0), vec2(1.0));

    vec2 b = clamp(uvMax, vec2(0.0), vec2(1.0));

    float z00 = textureLod(sampler2D(hiZPyramid, nearestSampler), vec2(a.x, a.y), mip).r;

    float z10 = textureLod(sampler2D(hiZPyramid, nearestSampler), vec2(b.x, a.y), mip).r;

    float z01 = textureLod(sampler2D(hiZPyramid, nearestSampler), vec2(a.x, b.y), mip).r;

    float z11 = textureLod(sampler2D(hiZPyramid, nearestSampler), vec2(b.x, b.y), mip).r;

    return max(max(z00, z10), max(z01, z11));
}

bool isOccludedByHiZ(vec3 worldCenter, float worldRadius, out float screenExtent)
{
    vec2 uvMin;
    vec2 uvMax;

    float nearestDepth;

    bool projected = projectSphereToScreen(worldCenter, worldRadius, uvMin, uvMax, nearestDepth, screenExtent);

    if (!projected)
    {
        return false;
    }

    if (isScreenRectOutside(uvMin, uvMax))
    {
        return false;
    }

    float mip = chooseHiZMip(uvMin, uvMax);

    float sceneMaxDepth = sampleHiZMaxDepth(uvMin, uvMax, mip);

    float depthBias = 0.05;

    return nearestDepth > sceneMaxDepth + depthBias;
}

uint chooseLodIndex(GpuMesh mesh, float screenExtent)
{
    uint lodCount = min(mesh.lodCount, MAX_MESH_LODS);

    if (lodCount <= 1u)
    {
        return 0u;
    }

    uint lodIndex = 0u;

    for (uint i = 1u; i < lodCount; ++i)
    {
        if (screenExtent <= mesh.lods[i].screenThreshold)
        {
            lodIndex = i;
        }
    }

    return lodIndex;
}

// ============================================================
// Main
// ============================================================

void main()
{
    uint visibleCandidateIndex = gl_GlobalInvocationID.x;

    if (visibleCandidateIndex >= visibleCandidateCount)
    {
        return;
    }

    uint drawableId = visibleCandidateIndices[visibleCandidateIndex];

    GpuDrawableObject drawable = drawables[drawableId];

    GpuMesh mesh = meshes[drawable.meshIndex];

    // ------------------------------------------------------------
    // Skip transparent meshes for now.
    // Transparent rendering will be separate.
    // ------------------------------------------------------------

    if (hasMeshFlag(mesh.meshFlags, MESH_FLAG_TRANSPARENT))
    {
        visibilityFlags[drawableId] = 0u;

        visibilityMasks[drawableId] = 0u;

        return;
    }

    mat4 modelMatrix = worldTransforms[drawable.transformIndex];

    vec3 worldCenter = (modelMatrix * vec4(mesh.boundingSphere.xyz, 1.0)).xyz;

    float worldRadius = mesh.boundingSphere.w * getMaxScale(modelMatrix);

    float screenExtent = 1.0;

    bool occluded = false;isOccludedByHiZ(worldCenter, worldRadius, screenExtent);

    if (occluded)
    {
        visibilityFlags[drawableId] = 0u;

        visibilityMasks[drawableId] = 0u;

        atomicAdd(stats.secondOcclusionRejected, 1u);

        return;
    }

    uint lodIndex = chooseLodIndex(mesh, screenExtent);

    uint commandIndex = drawable.meshIndex * MAX_MESH_LODS + lodIndex;

    MeshLod lod = mesh.lods[lodIndex];

    visibilityFlags[drawableId] = 1u;

    chosenMeshIds[drawableId] = commandIndex;

    // Временно включаем объект во все каскады.
    // Позже можно заменить на настоящий cascade mask.
    visibilityMasks[drawableId] = 0xFFFFFFFFu;

    uint oldInstanceCount = atomicAdd(commands[commandIndex].instanceCount, 1u);

    if (oldInstanceCount == 0u)
    {
        commands[commandIndex].indexCount = lod.indexCount;

        commands[commandIndex].firstIndex = lod.firstIndex;

        // Важно:
        // vertexOffset = 0.
        //
        // Index buffer хранит локальные индексы меша.
        // Вершинный шейдер сам делает:
        //
        // positionIndex  = mesh.positionOffset  + gl_VertexIndex;
        // attributeIndex = mesh.attributeOffset + gl_VertexIndex;
        commands[commandIndex].vertexOffset = 0;

        commands[commandIndex].firstInstance = 0u;
    }

    atomicAdd(stats.visibleDrawables, 1u);
}