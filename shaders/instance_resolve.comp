#version 450

#include "common_bindings.glsl"
#include "common_scene.glsl"
#include "common_frame.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME, binding = FRAME_INFO, std140) uniform FrameInfoBuffer
{
    FrameInfo frame;
};

layout(set = SET_FRAME, binding = FRAME_VISIBILITY_FLAGS, std430) readonly buffer VisibilityFlagsBuffer
{
    uint visibilityFlags[];
};

layout(set = SET_FRAME, binding = FRAME_CHOSEN_MESH_IDS, std430) readonly buffer ChosenMeshIdsBuffer
{
    uint chosenMeshIds[];
};

layout(set = SET_FRAME, binding = FRAME_INDIRECT_COMMANDS, std430) readonly buffer IndirectCommandBuffer
{
    VkDrawIndexedIndirectCommand commands[];
};

layout(set = SET_FRAME, binding = FRAME_MESH_WRITE_COUNTERS, std430) buffer MeshWriteCountersBuffer
{
    uint meshWriteCounters[];
};

layout(set = SET_FRAME, binding = FRAME_INSTANCE_REMAP, std430) writeonly buffer InstanceRemapBuffer
{
    uint instanceRemap[];
};

// ============================================================
// Main
// ============================================================

void main()
{
    uint drawableId = gl_GlobalInvocationID.x;

    if (drawableId >= frame.drawableCount) return;
    if (visibilityFlags[drawableId] == 0u) return;

    uint commandIndex = chosenMeshIds[drawableId];
    uint baseInstance = commands[commandIndex].firstInstance;
    uint localInstanceIndex = atomicAdd(meshWriteCounters[commandIndex], 1u);
    uint globalInstanceIndex = baseInstance + localInstanceIndex;

    instanceRemap[globalInstanceIndex] = drawableId;
}