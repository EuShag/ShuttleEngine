#version 450

#include "common_bindings.glsl"
#include "common_scene.glsl"
#include "common_frame.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ============================================================
// Constants
// ============================================================

#define MAX_FRUSTUMS 32

// ============================================================
// Frustum Data
// ============================================================

struct FrustumData
{
    vec4 planes[6];
};

// ============================================================
// Scene Set
// ============================================================

layout(set = SET_SCENE, binding = SCENE_DRAWABLES, std430) readonly buffer DrawableBuffer
{
    GpuDrawableObject drawables[];
};

layout(set = SET_SCENE, binding = SCENE_MESHES, std430) readonly buffer MeshBuffer
{
    GpuMesh meshes[];
};

// ============================================================
// Frame Set
// ============================================================

layout(set = SET_FRAME, binding = FRAME_INFO, std140) uniform FrameInfoBuffer
{
    FrameInfo frame;
};

layout(set = SET_FRAME, binding = FRAME_FRUSTUM_PLANES, std430) readonly buffer FrustumPlanesBuffer
{
    FrustumData frustums[];
};

layout(set = SET_FRAME, binding = FRAME_WORLD_TRANSFORMS, std430) readonly buffer WorldTransformBuffer
{
    mat4 worldTransforms[];
};

layout(set = SET_FRAME, binding = FRAME_CANDIDATE_INDICES, std430) writeonly buffer CandidateIndicesBuffer
{
    uint candidateIndices[];
};

layout(set = SET_FRAME, binding = FRAME_CANDIDATE_COUNT, std430) buffer CandidateCountBuffer
{
    uint candidateCount;
};

layout(set = SET_FRAME, binding = FRAME_VISIBILITY_MASKS, std430) buffer VisibilityMaskBuffer
{
    uint visibilityMasks[];
};

layout(set = SET_FRAME, binding = FRAME_RENDER_STATISTICS, std430) buffer RenderStatisticsBuffer
{
    RenderStatistics stats;
};

// ============================================================
// Helpers
// ============================================================

float getMaxScale(mat4 modelMatrix)
{
    float sx = length(modelMatrix[0].xyz);
    float sy = length(modelMatrix[1].xyz);
    float sz = length(modelMatrix[2].xyz);

    return max(max(sx, sy), sz);
}

bool isSphereVisible(vec3 worldCenter, float worldRadius, uint frustumIndex)
{
    for (int i = 0; i < 6; ++i)
    {
        vec4 plane = frustums[frustumIndex].planes[i];

        float normalLength = length(plane.xyz);

        if (normalLength <= 1e-6)
        {
            continue;
        }

        vec3 planeNormal = plane.xyz / normalLength;
        float planeDistance = plane.w / normalLength;

        float distanceToPlane =
        dot(planeNormal, worldCenter) + planeDistance;

        if (distanceToPlane < -worldRadius)
        {
            return false;
        }
    }

    return true;
}

// ============================================================
// Main
// ============================================================

void main()
{
    uint drawableId = gl_GlobalInvocationID.x;

    if (drawableId >= frame.drawableCount) return;

    GpuDrawableObject drawable = drawables[drawableId];
    GpuMesh mesh = meshes[drawable.meshIndex];

    mat4 modelMatrix = worldTransforms[drawable.transformIndex];

    vec3 worldCenter = (modelMatrix * vec4(mesh.boundingSphere.xyz, 1.0)).xyz;

    float worldRadius = mesh.boundingSphere.w * getMaxScale(modelMatrix);

    uint visibilityMask = 0u;

    uint frustumCount = min(frame.frustumCount, uint(MAX_FRUSTUMS));

    for (uint frustumIndex = 0u; frustumIndex < frustumCount; ++frustumIndex)
    {
        if (isSphereVisible(worldCenter, worldRadius, frustumIndex))
        {
            visibilityMask |= (1u << frustumIndex);
        }
    }

    visibilityMasks[drawableId] = visibilityMask;

    // bit 0 = camera frustum
    bool cameraVisible = (visibilityMask & 1u) != 0u;

    if (!cameraVisible)
    {
        atomicAdd(stats.frustumRejected, 1u);
        return;
    }

    uint candidateIndex = atomicAdd(candidateCount, 1u);
    candidateIndices[candidateIndex] = drawableId;
    atomicAdd(stats.candidateDrawables, 1u);
}