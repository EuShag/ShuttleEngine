prefix=C:/Program Files (x86)/shuttle_engine
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libmimalloc
Description: A compact general purpose allocator with excellent performance
Version: 3.5
URL: https://github.com/microsoft/mimalloc/
Libs: -L${libdir} -lmimalloc$<$<NOT:$<OR:$<CONFIG:Release>,$<CONFIG:RelWithDebInfo>,$<CONFIG:MinSizeRel>,$<CONFIG:none>>>:-$<LOWER_CASE:$<CONFIG>>>
Libs.private:  -lpsapi -lshell32 -luser32 -ladvapi32 -lbcrypt
Cflags: -I${includedir}
