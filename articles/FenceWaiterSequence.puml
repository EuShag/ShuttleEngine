@startuml
box "FenceWaiting"
    participant FW as "FenceWaiterThreadFunction"
endbox

box "TaskAwaiting"
    participant TS as "TaskState"
endbox

box "sharedResources"
    participant FP as "fencePool"
    participant FWQ as "fenceWaitingQueue"
endbox

participant VkDevice

FW -> FW : createFenceLocalBuffer()
FW -> FW : createFenceLocalBuffer2()
FW -> FW : createWaiterTaskFences()

loop while running == true
    FW -> VkDevice : vkWaitForFences(count, fenceLocalBuffer, 1000)
    note right of FW : vkWaitForFences вернёт\n VK_SUCCESS если хотя бы один сигнализирован

    loop for each boundFence in BoundFences
    FW -> VkDevice : vkGetFenceStatus(boundFence.fence)
    alt result == VK_SUCCESS
        alt boundFence.hasCoroHandle()
            FW -> FW : executor.schedule(boundFence.coroHandle)
        else
            FW -> FW : // нет handle — возможно уже снят/ошибка
        end
    else result == VK_NOT_READY
        FW -> FW : addToFenceLocalBuffer2(boundFence)
    end
end

    loop while !FWQ.empty()
        FW -> FWQ : dequeueFences()  // возвращает (fence, taskState) набор
        FW -> FW : addToFenceLocalBuffer2(fence, taskState)
    end
end
@enduml
